<Window x:Class="ScriptManager.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScriptManager"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{x:Static local:Strings.TitleConfigEditor}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static local:Strings.ConfigEditorNote}"
                   Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- 默认执行超时(秒)：配置编辑器内唯一允许手输的字段；占位符「0（不限制）」，× 清除回落默认 -->
        <Grid x:Name="TimeoutGrid" DockPanel.Dock="Bottom" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static local:Strings.ConfigEditorTimeoutLabel}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                    Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True"
                    BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushPanelBg}">
                <Grid>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="6,0,10,0"
                             PreviewTextInput="Timeout_PreviewTextInput" />
                    <TextBlock Text="{Binding Placeholder}"
                               Foreground="{DynamicResource BrushPlaceholder}" Margin="6,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                    <Button Style="{StaticResource ClearButton}"
                            Click="TimeoutClear_Click"
                            ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                            Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作条：左「默认值」一键还原，右「保存 / 取消」 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnReset" Content="{x:Static local:Strings.BtnDefault}"
                    HorizontalAlignment="Left" Width="80" Height="24"
                    Style="{StaticResource BaseButtonLight}" Click="BtnReset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="{x:Static local:Strings.BtnSave}" Width="80" Height="24"
                        Style="{StaticResource BaseButtonLight}" Click="BtnSave_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnCancel" Content="取消" Width="80" Height="24"
                        Style="{StaticResource BaseButtonLight}" Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Visibility="Collapsed"
                   Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,8" />

        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Label}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <!-- 与参数列表文件选择框一致：只读输入框 + 右侧「浏览」后缀按钮拼合为一体，只能选不能手输 -->
                        <DockPanel Grid.Column="1" Grid.Row="0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButtonLightSuffix}"
                                    Width="24" Height="24" Padding="0" Margin="0" VerticalAlignment="Center"
                                    Click="Browse_Click"
                                    ToolTip="{x:Static local:Strings.BrowseButtonToolTip}">
                                <svgc:SvgViewbox Width="13" Height="13"
                                                 UriSource='pack://application:,,,/assets/images/button/folder-open.svg'
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Border BorderThickness="1,1,0,1" CornerRadius="4,0,0,4"
                                    SnapsToDevicePixels="True" Height="24" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    Background="{DynamicResource BrushPanelBg}">
                                <Grid>
                                    <TextBox Text="{Binding Value}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" Padding="6,0,10,0" />
                                    <!-- 未自定义（Value 为空）时显示的默认相对路径占位符 -->
                                    <TextBlock Text="{Binding Placeholder}"
                                               Foreground="{DynamicResource BrushPlaceholder}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                                    <!-- 清空按钮：仅在已选择（Value 非空）时显示，点 × 回落到默认相对路径 -->
                                    <Button Style="{StaticResource ClearButton}"
                                            Click="Clear_Click"
                                            ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                                            Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
