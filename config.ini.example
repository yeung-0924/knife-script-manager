; knife-script-manager 配置文件（可选）
; 复制本文件为 exe 同级的 config/config.ini 即可生效；整段留空或注释则全部使用默认值。
; 修改后重启程序生效。

[script]
; 脚本目录（默认：exe 同级 script）
script_path = script
; 第三方依赖目录（默认：exe 同级 lib；注入环境变量 SCRIPT_MANAGER_LIB 供脚本引用）
lib_path = lib
; 运行时安装目录（默认：exe 同级 runtime；注入环境变量 SCRIPT_MANAGER_RUNTIME 供安装脚本默认使用）
runtime_path = runtime
; 缓存文件目录（默认：exe 同级 cache）
cache_path = cache
; 日志目录（默认：exe 同级 log，如 error.log）
log = log
